# Copy this file to .env and supply your own values. Never commit .env.
TELEGRAM_BOT_TOKEN=

# Paths are relative to the ultimate-bot directory unless absolute.
GOOGLE_SERVICE_ACCOUNT_PATH=sheets-service-account.json
NAS_SHEET_ID=
PP_SHEET_ID=
LK_SHEET_ID=
# Optional: spreadsheet creation requires a Drive location that allows it.
GOOGLE_DRIVE_FOLDER_ID=
SHEET_IDS_FILE=sheet_ids.json
RECORD_METADATA_FILE=record_metadata.json
SETTINGS_FILE=bot_settings.json
PENDING_FILES_FILE=pending_files.json
BACKUP_DIR=backups

# poll: direct long polling; webhook: direct Telegram webhook; bridge: n8n forwards updates.
BOT_MODE=poll
# Required for direct webhook mode only (public HTTPS base URL).
WEBHOOK_URL=
WEBHOOK_PORT=8080
# Required for webhook/bridge: random 16-256 letters, digits, underscores or hyphens.
WEBHOOK_SECRET=
BATCH_QUIET_SECONDS=5
# 10 MiB per upload; 100 pending files per chat.
MAX_UPLOAD_BYTES=10485760
MAX_PENDING_FILES=100
